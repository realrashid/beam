# Copied to rig/.env by CI (and by a developer setting the rig up). Values are for the rig only.
APP_NAME=BeamRig
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8090

LOG_CHANNEL=single
LOG_LEVEL=debug

DB_CONNECTION=sqlite
SESSION_DRIVER=file
CACHE_STORE=file
QUEUE_CONNECTION=sync

BROADCAST_CONNECTION=reverb
REVERB_APP_ID=beam-rig
REVERB_APP_KEY=beam-rig-key
REVERB_APP_SECRET=beam-rig-secret
REVERB_HOST="127.0.0.1"
REVERB_PORT=8091
REVERB_SCHEME=http

BEAM_SIGNALING=controller
BEAM_TIMEOUT=browser
BEAM_TURN=coturn
COTURN_SECRET=rig-secret
COTURN_URLS=turn:127.0.0.1:3478?transport=udp
